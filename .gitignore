# Python cache files
__pycache__/
*.py[cod]

# Virtual environments
venv/
.env/
.venv/
env/

# Environment/config files
*.env

# Packaging artifacts
*.egg-info/
dist/
build/

# IDE/editor folders
.vscode/
.idea/

# Data files (don't commit large datasets)
data/*.h5
data/*.hdf5
*.pkl
*.pickle

# MLflow - exclude heavy model artifacts and checkpoints
mlruns/*/models/
mlruns/*/.trash/
mlruns/*/artifacts/
*/downloaded_mlruns/
results/*/downloaded_mlruns/

# Model checkpoints (exclude large .pth files from all locations)
models/*.pth
results/models/*.pth
colab/models/*.pth
*.pth

# Large result files that can be regenerated
results/grid_search_*/downloaded_*

# Activation Maximization results
experiments/activation_maximization/improving_am_results/
# Ignore MLflow runs (entire trees)
mlruns/
**/mlruns/

# Ignore heavy per-run AM outputs, keep top-level summaries (CSV/JSON)
experiments/improving_am/**/run_*/
experiments/improving_am/**/filters/
experiments/activation_maximization/**/run_*/
experiments/activation_maximization/**/filters/

# Ignore bulky archives/logs under experiments
experiments/**/*.zip
experiments/**/*.log