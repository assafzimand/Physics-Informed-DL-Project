# Python cache files
__pycache__/
*.py[cod]

# Virtual environments
venv/
.env/
.venv/
env/

# Environment/config files
*.env

# Packaging artifacts
*.egg-info/
dist/
build/

# IDE/editor folders
.vscode/
.idea/

# Data files (don't commit large datasets)
# Default ignore, with explicit allowlist below for demo datasets
#
# Ignore patterns
#
# NOTE: keep these broad ignores, but allowlist the two demo validation files
# by adding negation rules after the ignores.

# Ignore general data files
data/*.h5
data/*.hdf5

# Allowlist specific demo/validation datasets
!data/wave_dataset_T250_validation.h5
!data/wave_dataset_T500_validation.h5

*.pkl
*.pickle

# MLflow - exclude heavy model artifacts and checkpoints
mlruns/*/models/
mlruns/*/.trash/
mlruns/*/artifacts/
*/downloaded_mlruns/
results/*/downloaded_mlruns/

# Model checkpoints (exclude large .pth files from all locations)
models/*.pth
results/models/*.pth
colab/models/*.pth
*.pth

# Allowlist specific demo models
!models/best_T250.pth
!models/best_T500.pth

# Large result files that can be regenerated
results/grid_search_*/downloaded_*

# Activation Maximization results
experiments/activation_maximization/improving_am_results/
# Ignore MLflow runs (entire trees)
mlruns/
**/mlruns/

# Ignore heavy per-run AM outputs, keep top-level summaries (CSV/JSON)
experiments/improving_am/**/run_*/
experiments/improving_am/**/filters/
experiments/activation_maximization/**/run_*/
experiments/activation_maximization/**/filters/

# Ignore bulky archives/logs under experiments
experiments/**/*.zip
experiments/**/*.log